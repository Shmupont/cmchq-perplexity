# CMC HQ — environment template. Copy to .env and fill in.
# Phase 1 (foundation) only needs no keys — yahoo-finance2 is free.
# Agents 2 (data) and 3 (intelligence) need the rest.

# AI (Agents 2 + 3)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-proj-...

# Gmail OAuth (Agent 2 — Inbox)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# Optional macro data (currently unused — yahoo-finance2 covers Phase 1)
FRED_API_KEY=
FINNHUB_API_KEY=

# Paths
OBSIDIAN_VAULT_PATH=~/Library/Mobile Documents/com~apple~CloudDocs/Desktop/obsidian brain

# App
NODE_ENV=development
